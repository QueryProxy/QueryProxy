APP_NAME=QueryProxy
APP_ENV=local
# Encrypts connection credentials and chat secrets. Generate with
# `php artisan key:generate --show`. When rotating, move the old key(s) into
# APP_PREVIOUS_KEYS (comma-separated) so existing ciphertexts stay readable.
APP_KEY=
# APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_URL=http://localhost:7432
# Keeps `php artisan serve` on the same port the Docker image and APP_URL use.
SERVER_PORT=7432

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# E-mail: password reset and the per-user e-mail notifications (Profile page,
# off until a user turns them on). With `log` nothing is delivered; the
# Profile page says so. Notification mail is sent from the queue worker (the
# `default` queue) and never carries query results; the SQL, when shown, has
# its values hidden (QUERYPROXY_CHAT_INCLUDE_SQL=none removes it).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- QueryProxy ---------------------------------------------------------
# Default LIMIT injected into SELECTs that have none.
QUERYPROXY_SELECT_DEFAULT_LIMIT=1000
# Hard cap: larger LIMITs are clamped down to this value.
QUERYPROXY_SELECT_HARD_LIMIT=10000
# Max seconds a single query request may run on the worker.
QUERYPROXY_EXECUTION_TIMEOUT=300
# Laravel filesystem disk that stores (masked) result files: local, s3, ...
# Never point this at the "public" disk: result paths are predictable
# (results/{team_id}/{id}.ndjson), so a public disk serves every team's
# rows straight from the web root and bypasses the download policy entirely.
QUERYPROXY_RESULT_DISK=local
# Days to keep result files before `results:prune` deletes them.
QUERYPROXY_RESULT_TTL_DAYS=30
# docker-compose only: seed demo team + users on first boot. Refused while
# APP_ENV=production unless QUERYPROXY_SEED_DEMO_FORCE=true is also set; the
# generated demo password is printed once in the container logs.
QUERYPROXY_SEED_DEMO=false
# QUERYPROXY_SEED_DEMO_FORCE=false

# Queue re-reservation window. Optional: when unset it defaults to
# QUERYPROXY_EXECUTION_TIMEOUT + 30 (330s for the default 300s), which already
# exceeds the worker --timeout (execution timeout + 10s, derived by the Docker
# entrypoint). Only set these to override that default; a value at or below
# the execution timeout logs a warning, since a slow query could then be
# picked up twice.
# DB_QUEUE_RETRY_AFTER=330
# REDIS_QUEUE_RETRY_AFTER=330

# Set to true when the app is served over HTTPS (behind a TLS proxy).
# SESSION_SECURE_COOKIE=true

# Comma-separated IPs/CIDRs of the reverse proxies allowed to set X-Forwarded-*.
# Empty (the default) trusts no proxy at all, which is correct when the app is
# reached directly. Behind a TLS-terminating proxy, list that proxy's address
# (e.g. 10.0.0.0/8 or 172.18.0.5) so HTTPS and the real client IP are seen.
# Never use "*": any client could then send its own X-Forwarded-For, which
# gives unlimited login and 2FA attempts (both throttles are keyed per IP) and
# writes a forged client IP into the audit trail.
# Read through config/queryproxy.php, so setting it here is enough. The
# container rebuilds the config cache on every boot; if you change the value on
# a running instance, refresh it with `php artisan config:cache`.
TRUSTED_PROXIES=

# Extra hostnames this installation answers to, beyond APP_URL's host
# (comma-separated). Empty means only APP_URL's host (and its www. sibling) is
# accepted as the request host.
TRUSTED_HOSTS=

# Additional untrusted procedural languages refused in CREATE EXTENSION and DO
# blocks, on top of the built-in list and the pl...u naming convention. These
# extend the built-in list; they cannot shorten it.
QUERYPROXY_EXTRA_UNTRUSTED_LANGUAGES=

# Additional server variables refused in SET GLOBAL / SET @@GLOBAL / SET PERSIST
# (comma-separated). Extends the built-in list of file-path, logging and plugin
# variables; cannot shorten it.
QUERYPROXY_EXTRA_DANGEROUS_VARIABLES=

# Who must have TOTP two-factor auth: none | admins | dba | all
QUERYPROXY_REQUIRE_2FA=none

# Scope of password login: all | admins_only | none
# admins_only: only system admins use a password (break-glass); none: password
# login and password reset are off, so SSO must work before you set it.
QUERYPROXY_LOCAL_LOGIN=all

# OpenID Connect single sign-on (Keycloak, Entra ID, Okta, Google, ...).
# On when both the issuer and the client id are set. Redirect URI to register
# at the provider: {APP_URL}/auth/oidc/callback
# QUERYPROXY_OIDC_ISSUER=
# QUERYPROXY_OIDC_CLIENT_ID=
# QUERYPROXY_OIDC_CLIENT_SECRET=
# QUERYPROXY_OIDC_SCOPES="openid email profile"
# Claim holding the user's groups, and the group:team:role map (comma-separated;
# team = slug or name; role = dba, developer or auditor), applied at every login.
# QUERYPROXY_OIDC_GROUP_CLAIM=groups
# QUERYPROXY_OIDC_ROLE_MAP=platform-dba:payments:dba,platform-dev:payments:developer

# Extra allowed hosts for outbound chat webhooks (comma-separated globs).
# QUERYPROXY_CHAT_WEBHOOK_ALLOWED_HOSTS=

# Block extra hosts for target connections (comma-separated, exact match).
# QUERYPROXY_CONNECTION_HOST_DENYLIST=
# Restrict SQLite target files to this directory.
# QUERYPROXY_SQLITE_ALLOWED_DIR=

# Chat SQL preview: literals_redacted (default), full or none
QUERYPROXY_CHAT_INCLUDE_SQL=literals_redacted

# Hours a request may stay pending before one reminder (0 = off)
QUERYPROXY_PENDING_REMIND_AFTER=4

# Target database timeouts and concurrency
QUERYPROXY_LOCK_TIMEOUT=5
QUERYPROXY_CONNECTION_SLOTS=2
QUERYPROXY_CONNECTION_SLOT_RETRY_DELAY=5

# REST API (/api/v1): longest lifetime of a personal access token, in days,
# and the request budget of each token per minute
# QUERYPROXY_API_TOKEN_MAX_DAYS=90
# QUERYPROXY_API_RATE_LIMIT=60

# GET /metrics (off until one of these is set)
# QUERYPROXY_METRICS_TOKEN=
# QUERYPROXY_METRICS_ALLOWED_IPS=

# SIEM export: stdout, syslog, webhook (comma-separated; off by default)
# QUERYPROXY_SIEM_SINKS=
# QUERYPROXY_SIEM_QUEUE=default
# QUERYPROXY_SIEM_STDOUT_STREAM=php://stdout
# QUERYPROXY_SIEM_SYSLOG_HOST=
# QUERYPROXY_SIEM_SYSLOG_PORT=
# QUERYPROXY_SIEM_SYSLOG_TRANSPORT=udp
# QUERYPROXY_SIEM_SYSLOG_FRAMING=octet-counting
# QUERYPROXY_SIEM_SYSLOG_FACILITY=13
# QUERYPROXY_SIEM_SYSLOG_APP_NAME=queryproxy
# QUERYPROXY_SIEM_SYSLOG_HOSTNAME=
# QUERYPROXY_SIEM_SYSLOG_TLS_CA_FILE=
# QUERYPROXY_SIEM_SYSLOG_TIMEOUT=5
# QUERYPROXY_SIEM_WEBHOOK_URL=
# QUERYPROXY_SIEM_WEBHOOK_SECRET=
# QUERYPROXY_SIEM_WEBHOOK_TIMEOUT=5
# QUERYPROXY_SIEM_WEBHOOK_TRIES=6

# External secret references for connection passwords (ADR-028): a connection's
# password may be vault://<mount>/<path>#<key>, aws-sm://<secret-id>[#<json-key>]
# or azure-kv://<vault-name>/<secret-name>[/<version>]. Resolved when a connection
# is opened and cached in process memory only. `php artisan queryproxy:doctor` checks these.
# QUERYPROXY_SECRET_CACHE_TTL=300
# QUERYPROXY_SECRET_TIMEOUT=5
# Which references a connection may use is set per team by a system administrator:
#   php artisan queryproxy:team:secret-prefixes <team> vault://secret/teams/payments
# A team without prefixes cannot use references.
# HashiCorp Vault (KV v2; auth: token | approle | kubernetes)
# QUERYPROXY_VAULT_ADDR=https://vault.example.com:8200
# QUERYPROXY_VAULT_NAMESPACE=
# QUERYPROXY_VAULT_AUTH=token
# QUERYPROXY_VAULT_TOKEN=
# QUERYPROXY_VAULT_ROLE_ID=
# QUERYPROXY_VAULT_SECRET_ID=
# QUERYPROXY_VAULT_APPROLE_MOUNT=approle
# QUERYPROXY_VAULT_K8S_ROLE=
# QUERYPROXY_VAULT_K8S_MOUNT=kubernetes
# QUERYPROXY_VAULT_K8S_JWT_PATH=/var/run/secrets/kubernetes.io/serviceaccount/token
# QUERYPROXY_VAULT_KV_VERSION=2
# KV mount paths, comma-separated (required for KV v1; also for mounts with slashes such as kv/prod)
# QUERYPROXY_VAULT_MOUNTS=secret
# QUERYPROXY_VAULT_CA_FILE=
# AWS Secrets Manager: the SDK's default credential chain (AWS_ACCESS_KEY_ID, IRSA, ECS task role, instance profile)
# QUERYPROXY_AWS_REGION=
# Azure Key Vault (auth: auto | client_secret | workload_identity | managed_identity)
# QUERYPROXY_AZURE_AUTH=auto
# QUERYPROXY_AZURE_TENANT_ID=
# QUERYPROXY_AZURE_CLIENT_ID=
# QUERYPROXY_AZURE_CLIENT_SECRET=
# QUERYPROXY_AZURE_FEDERATED_TOKEN_FILE=
# QUERYPROXY_AZURE_VAULT_DNS_SUFFIX=vault.azure.net

# Secrets from files (Docker / Kubernetes secrets); never together with the plain variable
# APP_KEY_FILE=
# APP_PREVIOUS_KEYS_FILE=
# DB_PASSWORD_FILE=
# MAIL_PASSWORD_FILE=
# REDIS_PASSWORD_FILE=
# SLACK_BOT_USER_OAUTH_TOKEN_FILE=
# QUERYPROXY_ADMIN_PASSWORD_FILE=
# QUERYPROXY_METRICS_TOKEN_FILE=
# QUERYPROXY_OIDC_CLIENT_SECRET_FILE=
# QUERYPROXY_SIEM_WEBHOOK_SECRET_FILE=
# QUERYPROXY_VAULT_TOKEN_FILE=
# QUERYPROXY_VAULT_SECRET_ID_FILE=
# QUERYPROXY_AZURE_CLIENT_SECRET_FILE=
